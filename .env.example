# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_db"

# ─── PostgreSQL (used by Docker Compose) ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin 
POSTGRES_DB=real_estate_db

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=3001

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── JWT & Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# ─── Commission Configuration ────────────────────────────────────────────────
COMMISSION_RATE=0.02
AGENT_SHARE_RATE=0.5

# ─── IA (Claude) ─────────────────────────────────────────────────────────────
# Clé à créer sur https://platform.claude.com (à mettre dans backend/.env, jamais dans le frontend)
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut : claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Agence (messages de confirmation de visite, assistant du site) ──────────
AGENCY_NAME=Le Portail Immobilier
AGENCY_ADDRESS=
AGENCY_MAPS_URL=
AGENCY_PHONE=
# Fuseau de l'agence pour le calcul des journées (Tunisie : +01:00)
AGENCY_UTC_OFFSET=+01:00
