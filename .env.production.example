# ==================================
# DATABASE - NEON POSTGRESQL (Production)
# ==================================
DATABASE_URL="postgresql://user:password@host.region.neon.tech/dbname?sslmode=require"

# ==================================
# SERVER
# ==================================
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://votre-domaine-frontend.vercel.app

# ==================================
# JWT AUTHENTICATION
# ==================================
JWT_SECRET=votre_secret_jwt_production_tres_securise_min_32_caracteres
JWT_EXPIRES_IN=7d

# ==================================
# COMMISSION CONFIGURATION
# ==================================
COMMISSION_RATE=0.02
AGENT_SHARE_RATE=0.5

# ==================================
# CLOUDINARY STORAGE
# ==================================
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
