# Copier en .env.production (jamais dans git) puis :
#   docker compose --env-file .env.production up -d --build

# Adresse publique du site, en HTTPS, sans « / » final
PUBLIC_URL=https://votre-domaine.tn
FRONTEND_PORT=3000

# Base de données (le mot de passe ne doit pas être « postgres »)
POSTGRES_USER=immo
POSTGRES_PASSWORD=
POSTGRES_DB=real_estate_db

# 64 caractères aléatoires, par exemple : openssl rand -hex 32
JWT_SECRET=
# Durée d'une session du personnel (reconnexion chaque jour)
JWT_EXPIRES_IN=1d
# Optionnel : secret distinct pour les liens signés des documents (openssl rand -hex 32)
FILES_SECRET=

# Optionnel : IA Claude (sinon le moteur de règles gratuit est utilisé)
ANTHROPIC_API_KEY=

AGENCY_UTC_OFFSET=+01:00
