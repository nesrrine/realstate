generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  firstName         String
  lastName          String
  phone             String?
  role              Role             @default(AGENT)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  passwordHash      String
  passwordChangedAt DateTime?
  agent             Agent?
  cashEntries       CashEntry[]
  studioCreations   StudioCreation[]

  @@map("users")
}

model Agent {
  id                      String              @id @default(cuid())
  userId                  String              @unique
  licenseNumber           String?             @unique
  bio                     String?
  avatarUrl               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  agentType               AgentType           @default(FIELD)
  canManageCash           Boolean             @default(false)
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientInteractions      ClientInteraction[]
  clients                 Client[]            @relation("ClientAgent")
  fieldClients            Client[]            @relation("ClientFieldAgent")
  leads                   Lead[]
  notifications           Notification[]
  properties              Property[]
  fieldAgentTransactions  Transaction[]       @relation("FieldAgentTransactions")
  officeAgentTransactions Transaction[]       @relation("OfficeAgentTransactions")
  fieldAgentVisits        Visit[]             @relation("FieldAgentVisits")
  officeAgentVisits       Visit[]             @relation("OfficeAgentVisits")

  @@map("agents")
}

model Client {
  id                     String              @id @default(cuid())
  agentId                String
  firstName              String
  lastName               String
  email                  String?             @unique
  phone                  String
  notes                  String?
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  address                String?
  bedrooms               Int?
  budgetMax              Decimal?            @db.Decimal(12, 2)
  budgetMin              Decimal?            @db.Decimal(12, 2)
  city                   String?
  minSurface             Float?
  preferredPropertyTypes String[]
  preferredZones         String[]
  transactionType        TransactionType?
  whatsapp               String?
  zipCode                String?
  clientType             ClientType?
  status                 ContactStatus       @default(PROSPECT)
  followUpStatus         FollowUpStatus      @default(TO_CONTACT)
  lastInteractionAt      DateTime?
  nextFollowUpAt         DateTime?
  professionalAddress    String?
  cinOrPassport          String?
  fieldAgentId           String?
  financing              String?
  needDescription        String?
  interactions           ClientInteraction[]
  agent                  Agent               @relation("ClientAgent", fields: [agentId], references: [id])
  fieldAgent             Agent?              @relation("ClientFieldAgent", fields: [fieldAgentId], references: [id])
  leads                  Lead[]
  notifications          Notification[]
  transactions           Transaction[]
  visits                 Visit[]

  @@index([agentId])
  @@index([isActive])
  @@index([status])
  @@index([clientType])
  @@map("clients")
}

model Owner {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String?       @unique
  phone        String
  address      String?
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  city         String?
  country      String?       @default("TN")
  whatsapp     String?
  zipCode      String?
  properties   Property[]
  transactions Transaction[]

  @@index([isActive])
  @@map("owners")
}

model Property {
  id                       String             @id @default(cuid())
  agentId                  String
  ownerId                  String
  title                    String
  description              String?
  type                     PropertyType
  status                   PropertyStatus     @default(DRAFT)
  address                  String
  city                     String
  district                 String?
  zipCode                  String?
  country                  String             @default("TN")
  latitude                 Float?
  longitude                Float?
  surface                  Float
  rooms                    Int?
  bedrooms                 Int?
  bathrooms                Int?
  floor                    Int?
  totalFloors              Int?
  parking                  Boolean            @default(false)
  furnished                Boolean            @default(false)
  elevator                 Boolean            @default(false)
  balcony                  Boolean            @default(false)
  garden                   Boolean            @default(false)
  cellar                   Boolean            @default(false)
  price                    Decimal            @db.Decimal(12, 2)
  pricePerSqm              Decimal?           @db.Decimal(10, 2)
  charges                  Decimal?           @db.Decimal(10, 2)
  deposit                  Decimal?           @db.Decimal(10, 2)
  isPublished              Boolean            @default(false)
  publishedAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  transactionType          TransactionType    @default(SALE)
  reference                String             @unique
  titleDeedNumber          String?
  googleMapsUrl            String?
  businessActivity         String?
  businessDailyRevenue     Decimal?           @db.Decimal(12, 2)
  businessEmployees        Int?
  businessRent             Decimal?           @db.Decimal(10, 2)
  landCorner               Boolean            @default(false)
  landCos                  Float?
  landCuf                  Float?
  landDepth                Float?
  landFrontage             Float?
  landServiced             Boolean            @default(false)
  landZoning               String?
  commercialCeilingHeight  Float?
  commercialFrontage       Float?
  commercialLeased         Boolean            @default(false)
  commercialMezzanine      Boolean            @default(false)
  commercialMonthlyRevenue Decimal?           @db.Decimal(12, 2)
  titleType                String?
  notes                    String?
  leadProperties           LeadProperty[]
  agent                    Agent              @relation(fields: [agentId], references: [id])
  owner                    Owner              @relation(fields: [ownerId], references: [id])
  documents                PropertyDocument[]
  images                   PropertyImage[]
  studioCreations          StudioCreation[]
  transactions             Transaction[]
  visitProperties          VisitProperty[]

  @@index([status])
  @@index([type])
  @@index([city])
  @@index([agentId])
  @@index([ownerId])
  @@index([transactionType])
  @@index([isPublished])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([city, status])
  @@index([status, isPublished])
  @@index([price])
  @@index([surface])
  @@map("properties")
}

model PropertyImage {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  altText      String?
  isCover      Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  mimeType     String?
  originalName String?
  size         Int?
  storageKey   String?
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model PropertyDocument {
  id                     String   @id @default(cuid())
  propertyId             String
  title                  String
  description            String?
  url                    String
  storageKey             String
  size                   Int?
  mimeType               String?
  originalName           String?
  category               String?
  createdAt              DateTime @default(now())
  cloudinaryDeliveryType String?  @default("private") @map("cloudinary_delivery_type")
  cloudinaryPublicId     String?  @map("cloudinary_public_id")
  cloudinaryResourceType String?  @map("cloudinary_resource_type")
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([category])
  @@map("property_documents")
}

model Lead {
  id           String         @id @default(cuid())
  clientId     String
  agentId      String
  status       LeadStatus     @default(NEW)
  notes        String?
  budget       Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lostDate     DateTime?
  lostReason   String?
  nextFollowUp DateTime?
  wonDate      DateTime?
  source       LeadSource     @default(OTHER)
  activities   LeadActivity[]
  properties   LeadProperty[]
  agent        Agent          @relation(fields: [agentId], references: [id])
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([agentId])
  @@index([clientId])
  @@index([source])
  @@map("leads")
}

model LeadProperty {
  id         String   @id @default(cuid())
  leadId     String
  propertyId String
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leadId, propertyId])
  @@index([leadId])
  @@index([propertyId])
  @@map("lead_properties")
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  agentId   String?
  type      LeadActivityType
  title     String
  body      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_activities")
}

model ClientInteraction {
  id         String          @id @default(cuid())
  clientId   String
  agentId    String?
  type       InteractionType
  title      String
  body       String?
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  agent      Agent?          @relation(fields: [agentId], references: [id])
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([occurredAt])
  @@map("client_interactions")
}

model Visit {
  id            String          @id @default(cuid())
  clientId      String
  status        VisitStatus     @default(SCHEDULED)
  scheduledAt   DateTime
  completedAt   DateTime?
  duration      Int?
  feedback      String?
  rating        Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  fieldAgentId  String
  officeAgentId String
  visitType     VisitType       @default(IN_PERSON)
  cashEntries   CashEntry[]
  properties    VisitProperty[]
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fieldAgent    Agent           @relation("FieldAgentVisits", fields: [fieldAgentId], references: [id])
  officeAgent   Agent           @relation("OfficeAgentVisits", fields: [officeAgentId], references: [id])

  @@index([status])
  @@index([scheduledAt])
  @@index([fieldAgentId])
  @@index([officeAgentId])
  @@index([clientId])
  @@index([createdAt])
  @@map("visits")
}

model VisitProperty {
  id         String   @id @default(cuid())
  visitId    String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, propertyId])
  @@index([visitId])
  @@index([propertyId])
  @@map("visit_properties")
}

model Transaction {
  id              String            @id @default(cuid())
  propertyId      String
  clientId        String
  ownerId         String
  type            TransactionType
  amount          Decimal           @db.Decimal(12, 2)
  agencyFeeRate   Decimal?          @db.Decimal(5, 4)
  agencyFeeAmount Decimal?          @db.Decimal(10, 2)
  date            DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  status          TransactionStatus @default(PENDING)
  fieldAgentId    String
  officeAgentId   String
  commission      Commission?
  client          Client            @relation(fields: [clientId], references: [id])
  fieldAgent      Agent             @relation("FieldAgentTransactions", fields: [fieldAgentId], references: [id])
  officeAgent     Agent             @relation("OfficeAgentTransactions", fields: [officeAgentId], references: [id])
  owner           Owner             @relation(fields: [ownerId], references: [id])
  property        Property          @relation(fields: [propertyId], references: [id])

  @@index([type])
  @@index([status])
  @@index([fieldAgentId])
  @@index([officeAgentId])
  @@index([propertyId])
  @@index([clientId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("transactions")
}

model Commission {
  id                   String                  @id @default(cuid())
  transactionId        String                  @unique
  amount               Decimal                 @db.Decimal(10, 2) // total = buyerAmount + sellerAmount
  paidAt               DateTime?
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  commissionRate       Decimal                 @db.Decimal(5, 4) // taux global = acheteur + vendeur
  buyerCommissionRate  Decimal?                @db.Decimal(5, 4)
  sellerCommissionRate Decimal?                @db.Decimal(5, 4)
  buyerAmount          Decimal                 @default(0) @db.Decimal(10, 2) // NOUVEAU
  sellerAmount         Decimal                 @default(0) @db.Decimal(10, 2) // NOUVEAU
  agencyAmount         Decimal                 @db.Decimal(10, 2)
  paymentStatus        CommissionPaymentStatus @default(PENDING)
  fieldAgentAmount     Decimal                 @db.Decimal(10, 2)
  officeAgentAmount    Decimal                 @db.Decimal(10, 2)
  fieldAgentShareRate  Decimal                 @db.Decimal(5, 4)
  officeAgentShareRate Decimal                 @db.Decimal(5, 4)
  transaction          Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@map("commissions")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Notification {
  id        String    @id @default(cuid())
  agentId   String?
  clientId  String?
  title     String
  body      String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  link      String?
  createdAt DateTime  @default(now())
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agentId, isRead])
  @@index([clientId, isRead])
  @@map("notifications")
}

model CashEntry {
  id            String        @id @default(cuid())
  type          CashEntryType
  date          DateTime      @db.Date
  amount        Decimal       @db.Decimal(10, 2)
  label         String
  category      String?
  paymentMethod String?
  visitId       String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User          @relation(fields: [createdById], references: [id])
  visit         Visit?        @relation(fields: [visitId], references: [id])

  @@index([date])
  @@index([type])
  @@map("cash_entries")
}

model StudioCreation {
  id            String   @id @default(cuid())
  propertyId    String
  title         String
  template      String
  format        String
  imageUrls     String[]
  descriptionFr String?
  descriptionTn String?
  descriptionIg String?
  status        String   @default("DRAFT")
  platform      String?
  shareUrl      String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([template])
  @@index([createdAt])
  @@index([createdById])
  @@map("studio_creations")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  LAND
  COMMERCIAL
  OFFICE
  BUSINESS
  OTHER
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENTAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  NEGOTIATION
  WON
  LOST
  A_CONTACT
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  PHONE
  WALK_IN
  REFERRAL
  OTHER
}

enum AgentType {
  FIELD
  OFFICE
}

enum ClientType {
  BUYER
  SELLER
  RENTER
}

enum ContactStatus {
  PROSPECT
  CLIENT
}

enum FollowUpStatus {
  TO_CONTACT
  CONTACTED
  NEGOTIATION
  WON
  LOST
}

enum InteractionType {
  CALL
  MESSAGE
  VISIT
  NOTE
  EMAIL
}

enum LeadActivityType {
  STATUS_CHANGED
  NOTE_ADDED
  AGENT_ASSIGNED
  CLIENT_LINKED
  PROPERTY_LINKED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  OFFER_MADE
  CREATED
}

enum VisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitType {
  IN_PERSON
  REMOTE
}

enum TransactionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommissionPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum CashEntryType {
  VISIT_FEE
  EXPENSE
}
